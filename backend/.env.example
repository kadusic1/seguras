DB_DSN=seguras_app:password@tcp(127.0.0.1:3306)/seguras_db
JWT_SECRET=change-me-in-production
ACCESS_TTL=15m
REFRESH_TTL=720h
PORT=8080
CORS_ORIGIN=http://localhost:3000
ITEMS_PER_PAGE=10
PRESIGN_EXPIRY=15m

# # Rate limiter (per client IP, resolved from Cloudflare's CF-Connecting-IP header)
# RATE_LIMIT_REQUESTS=100
# RATE_LIMIT_WINDOW=1m

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.email@gmail.com
SMTP_PASSWORD=abcd1234efgh5678
FROM_EMAIL=your.email@gmail.com
NOTIFICATION_EMAIL=your.email@gmail.com

# B2 cloud storage (Backblaze)
# B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
# B2_KEY_ID=
# B2_APP_KEY=
# B2_BUCKET=
# B2_REGION=

# Reset script credentials (not consumed by the app)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=seguras_db
DB_ROOT_USER=root
DB_ROOT_PASSWORD=
DB_APP_USER=seguras_app
DB_APP_PASSWORD=change-me

# Seed data (used by reset.sh)
SEED_NAME=Admin
SEED_LASTNAME=User
SEED_EMAIL=admin@example.com
SEED_PASSWORD=change-me

# Sweeper config
ORPHAN_GRACE=24h
