# Containerized database - single source of truth for docker compose
# (interpolation) and backend/reset-docker.sh (sourced). The local native
# MariaDB used for dev keeps its own credentials in backend/.env (reset.sh).
DB_NAME=seguras_db
DB_ROOT_USER=root
DB_ROOT_PASSWORD=change-me
DB_APP_USER=seguras_app
DB_APP_PASSWORD=change-me

# Host-side port reachable for host tooling (reset.sh, seed, sweeper).
# Default 3306; use 3307 on a host where another MariaDB already owns 3306.
DB_PORT=3306